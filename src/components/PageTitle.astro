---
// Page head like tailwindcss.com/docs: kicker, large title, lead paragraph (the page description).
import type { StarlightRouteData } from '@astrojs/starlight/route-data';

const PAGE_TITLE_ID = '_top'; // Starlight links "Overview" in the table of contents to this id.

const route = Astro.locals.starlightRoute;
const { title, description, kicker, template } = route.entry.data;

type Entry = StarlightRouteData['sidebar'][number];
function groupOfCurrent(entries: Entry[], parent?: string): string | undefined {
  for (const entry of entries) {
    if (entry.type === 'link' && entry.isCurrent) return parent;
    if (entry.type === 'group') {
      const found = groupOfCurrent(entry.entries, entry.label);
      if (found !== undefined) return found;
    }
  }
  return undefined;
}

const label = kicker ?? groupOfCurrent(route.sidebar);
const showHead = template !== 'splash';
---

{showHead && label && <p class="mg-kicker">{label}</p>}
<h1 id={PAGE_TITLE_ID} class:list={{ 'mg-title': showHead }}>
  {title}
</h1>
{showHead && description && <p class="mg-lead">{description}</p>}

<style>
  h1 {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .mg-title {
    margin-top: 0.25rem;
    letter-spacing: -0.025em;
  }
</style>
