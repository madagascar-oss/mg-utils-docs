---
// Landing page: a compact headline, then an editor that types the same receipt in the reader's
// stack (TypeScript, React, Vue, Angular, Svelte, Node, PHP, Laravel, Symfony) while a preview
// fills in, then where it runs and what it is for. The page renders complete without JavaScript
// (and with reduced motion); the script only replays it as typing. Every result shown is
// computed at build time by the library (demo.ts).
import { localePath, t, type Locale, type UiKey } from '../../i18n/ui.ts';
import {
  fields,
  installs,
  modules,
  operatorName,
  samples,
  useCases,
  type FieldId,
  type Line,
  type SampleGroup,
  type UseCaseId,
} from './demo.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = (key: UiKey) => t(locale, key);
const DEFAULT_SAMPLE = samples[0];
const rows: { id: FieldId; label: UiKey }[] = [
  { id: 'words', label: 'home.field.words' },
  { id: 'phone', label: 'home.field.phone' },
  { id: 'date', label: 'home.field.date' },
];
const groups: { id: SampleGroup; label: UiKey }[] = [
  { id: 'js', label: 'home.group.js' },
  { id: 'php', label: 'home.group.php' },
];
const moduleLabel = {
  words: s('play.module.words'),
  phone: s('play.module.phone'),
  ariary: s('play.module.ariary'),
  date: s('play.module.date'),
};
const caseText: Record<UseCaseId, { title: UiKey; when: UiKey }> = {
  signup: { title: 'home.case.signup', when: 'home.case.signup.when' },
  cheque: { title: 'home.case.cheque', when: 'home.case.cheque.when' },
  form: { title: 'home.case.form', when: 'home.case.form.when' },
  francs: { title: 'home.case.francs', when: 'home.case.francs.when' },
  traditional: { title: 'home.case.traditional', when: 'home.case.traditional.when' },
  calendar: { title: 'home.case.calendar', when: 'home.case.calendar.when' },
};
const jsStacks = [
  'React',
  'Next.js',
  'Vue',
  'Nuxt',
  'Angular',
  'Svelte',
  'Astro',
  'Node.js',
  'Bun',
  'Deno',
  'Express',
  'Browser',
];
const phpStacks = ['PHP', 'Laravel', 'Symfony', 'WordPress', 'Slim', 'Laminas'];
const sampleData = Object.fromEntries(samples.map((sample) => [sample.id, sample.lines]));
const lineText = (line: Line) => line.tokens.map((token) => token.text).join('');
const doc = (path: string) => localePath(locale, `/docs/${path}/`);
---

<div class="not-content mg-landing">
  <section class="mg-hero">
    <h1 id="_top">{s('home.title')}</h1>
    <p class="mg-hero-lead">{s('home.lead')}</p>
    <div class="mg-hero-actions">
      <a class="mg-btn mg-btn-primary" href={doc('installation/using-npm')}>
        {s('home.start')}
      </a>
      <a class="mg-btn" href={localePath(locale, '/play/')}>
        {s('home.play')}
      </a>
      {[installs.js[0], installs.php[0]].map((command) => (
        <div class="mg-install-pill">
          <span aria-hidden="true">$</span>
          <code>{command}</code>
          <button
            type="button"
            data-copy={command}
            data-label={s('home.copy')}
            data-done={s('home.copied')}
          >
            {s('home.copy')}
          </button>
        </div>
      ))}
    </div>
  </section>

  <section
    class="mg-demo"
    aria-label={s('home.demo')}
    data-demo
    data-samples={JSON.stringify(sampleData)}
  >
    <div class="mg-editor">
      <div class="mg-editor-bar" role="tablist" aria-label={s('home.stack')}>
        {groups.map((group) => (
          <div class="mg-tab-group">
            <span class="mg-tab-group-label">{s(group.label)}</span>
            {samples
              .filter((sample) => sample.group === group.id)
              .map((sample) => (
                <button
                  type="button"
                  role="tab"
                  data-sample={sample.id}
                  data-file={sample.file}
                  aria-selected={sample.id === DEFAULT_SAMPLE.id ? 'true' : 'false'}
                >
                  {sample.label}
                </button>
              ))}
          </div>
        ))}
      </div>
      <div class="mg-file-bar">
        <span class="mg-dots" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <span class="mg-file" data-file-name>
          {DEFAULT_SAMPLE.file}
        </span>
        <button type="button" class="mg-replay" data-replay>
          {s('home.replay')}
        </button>
      </div>
      <pre class="mg-code" data-lines><code>{
        DEFAULT_SAMPLE.lines.map((line) => (
          <span class="mg-line">
            {line.tokens.map((token) => <span class={`tk-${token.kind}`}>{token.text}</span>)}
            {lineText(line) === '' && ' '}
          </span>
        ))
      }</code></pre>
    </div>

    <div class="mg-preview">
      <p class="mg-preview-label">{s('home.preview')}</p>
      <div class="mg-receipt">
        <p class="mg-receipt-title">
          <span class="mg-check" aria-hidden="true">
            ✓
          </span>
          {s('home.receipt')}
        </p>
        <p class="mg-amount" data-field="amount">
          {fields.amount}
        </p>
        <dl>
          {rows.map((row) => (
            <div data-field={row.id}>
              <dt>{s(row.label)}</dt>
              <dd>
                {fields[row.id]}
                {row.id === 'phone' && <span class="mg-badge">{operatorName}</span>}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="mg-section" aria-labelledby="mg-everywhere">
    <h2 id="mg-everywhere">{s('home.everywhere')}</h2>
    <div class="mg-platforms">
      <article class="mg-platform">
        <h3>{s('home.js.title')}</h3>
        <p>{s('home.js.lead')}</p>
        <ul class="mg-chips" aria-label={s('home.js.title')}>
          {jsStacks.map((name) => (
            <li>{name}</li>
          ))}
        </ul>
        <p class="mg-req">
          <strong>{s('home.requirements')}</strong> {s('home.js.req')}
        </p>
        <div class="mg-commands">
          {installs.js.map((command) => (
            <code>{command}</code>
          ))}
        </div>
        <p class="mg-links">
          <a href={doc('installation/using-npm')}>npm</a>
          <a href={doc('installation/using-utils-bundle')}>{s('home.js.docs')}</a>
        </p>
      </article>
      <article class="mg-platform">
        <h3>{s('home.php.title')}</h3>
        <p>{s('home.php.lead')}</p>
        <ul class="mg-chips" aria-label={s('home.php.title')}>
          {phpStacks.map((name) => (
            <li>{name}</li>
          ))}
        </ul>
        <p class="mg-req">
          <strong>{s('home.requirements')}</strong> {s('home.php.req')}
        </p>
        <div class="mg-commands">
          {installs.php.map((command) => (
            <code>{command}</code>
          ))}
        </div>
        <p class="mg-links">
          <a href={doc('installation/using-composer')}>Composer</a>
          <a href={doc('installation/using-laravel')}>Laravel: {s('home.php.laravel')}</a>
          <a href={doc('installation/using-symfony')}>Symfony: {s('home.php.symfony')}</a>
        </p>
      </article>
    </div>
  </section>

  <section class="mg-section" aria-labelledby="mg-cases">
    <h2 id="mg-cases">{s('home.cases')}</h2>
    <div class="mg-cases">
      {useCases.map((useCase) => (
        <article class="mg-case">
          <h3>{s(caseText[useCase.id].title)}</h3>
          <p>{s(caseText[useCase.id].when)}</p>
          <pre><code>{useCase.code}</code></pre>
          <ul class="mg-results">
            {useCase.results.map((result) => (
              <li>{result}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="mg-section" aria-labelledby="mg-modules-title">
    <h2 id="mg-modules-title">{s('home.modules')}</h2>
    <div class="mg-module-grid">
      {modules.map((module) => (
        <a class="mg-module" href={doc(module.id)}>
          <span class="mg-module-name">{moduleLabel[module.id]}</span>
          <code class="mg-module-call">{module.call}</code>
          <span class="mg-module-result">{module.result}</span>
        </a>
      ))}
    </div>
  </section>
</div>

<script>
  import type { Line } from './demo.ts';

  const CHAR_MS = 18;
  const LINE_PAUSE_MS = 260;
  const FLASH_MS = 900;
  const COPIED_MS = 1500;
  const EMPTY = 'is-empty';
  const TYPING = 'is-typing';
  const FILLED = 'is-filled';
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  function renderLine(line: Line, visible: number): HTMLElement {
    const row = document.createElement('span');
    row.className = 'mg-line';
    let left = visible;
    for (const token of line.tokens) {
      if (left <= 0) break;
      const span = document.createElement('span');
      span.className = `tk-${token.kind}`;
      span.textContent = token.text.slice(0, left);
      left -= token.text.length;
      row.append(span);
    }
    if (row.childNodes.length === 0) row.append(' ');
    return row;
  }

  const lengthOf = (line: Line) => line.tokens.reduce((sum, token) => sum + token.text.length, 0);

  function setUpDemo(demo: HTMLElement, target: HTMLElement): void {
    const sources = JSON.parse(demo.dataset.samples ?? '{}') as Record<string, Line[]>;
    const tabs = [...demo.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const outputs = [...demo.querySelectorAll<HTMLElement>('[data-field]')];
    const fileName = demo.querySelector<HTMLElement>('[data-file-name]');
    let sample =
      tabs.find((tab) => tab.getAttribute('aria-selected') === 'true')?.dataset.sample ?? '';
    let run = 0;

    const showAll = () => {
      target.replaceChildren(...(sources[sample] ?? []).map((line) => renderLine(line, Infinity)));
      target.classList.remove(TYPING);
      for (const output of outputs) output.classList.remove(EMPTY, FILLED);
    };

    async function play(): Promise<void> {
      const id = ++run;
      const lines = sources[sample] ?? [];
      if (reducedMotion) return showAll();
      target.replaceChildren();
      target.classList.add(TYPING);
      for (const output of outputs) output.classList.add(EMPTY);
      for (const line of lines) {
        if (id !== run) return;
        if (!line.field) {
          target.append(renderLine(line, Infinity));
          continue;
        }
        const total = lengthOf(line);
        let row = renderLine(line, 0);
        target.append(row);
        for (let typed = 1; typed <= total; typed += 1) {
          await sleep(CHAR_MS);
          if (id !== run) return;
          const next = renderLine(line, typed);
          row.replaceWith(next);
          row = next;
        }
        for (const output of outputs.filter((o) => o.dataset.field === line.field)) {
          output.classList.remove(EMPTY);
          output.classList.add(FILLED);
          setTimeout(() => output.classList.remove(FILLED), FLASH_MS);
        }
        await sleep(LINE_PAUSE_MS);
      }
      target.classList.remove(TYPING);
    }

    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        sample = tab.dataset.sample ?? sample;
        for (const other of tabs) other.setAttribute('aria-selected', String(other === tab));
        if (fileName) fileName.textContent = tab.dataset.file ?? '';
        void play();
      });
    }
    demo.querySelector('[data-replay]')?.addEventListener('click', () => void play());

    if (!reducedMotion) {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect();
          void play();
        }
      });
      observer.observe(demo);
    }
  }

  for (const demo of document.querySelectorAll<HTMLElement>('[data-demo]')) {
    const target = demo.querySelector<HTMLElement>('[data-lines] code');
    if (target) setUpDemo(demo, target);
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', () => {
      navigator.clipboard.writeText(button.dataset.copy ?? '').then(
        () => {
          button.textContent = button.dataset.done ?? '';
          setTimeout(() => (button.textContent = button.dataset.label ?? ''), COPIED_MS);
        },
        () => {
          // Clipboard blocked (permissions, insecure context): the command stays selectable.
        },
      );
    });
  }
</script>

<style>
  .mg-landing {
    --mg-editor-bg: #0d1117;
    --mg-editor-line: #30363d;
    max-width: 76rem;
    margin-inline: auto;
    padding-bottom: 4rem;
  }

  /* Hero: compact, so the demo is visible without scrolling. */
  .mg-hero {
    padding-block: 1.5rem 1.25rem;
  }

  .mg-hero h1 {
    font-size: clamp(1.9rem, 3.6vw, 2.75rem);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--sl-color-white);
  }

  .mg-hero-lead {
    max-width: 46rem;
    margin-top: 0.75rem;
    font-size: var(--sl-text-base);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }

  .mg-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.1rem;
  }

  .mg-btn {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.45rem 1rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    color: var(--sl-color-white);
    box-shadow: inset 0 0 0 1px var(--sl-color-gray-5);
  }

  .mg-btn:hover {
    background: var(--sl-color-gray-6);
  }

  .mg-btn-primary,
  .mg-btn-primary:hover {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    box-shadow: none;
  }

  :global(:root[data-theme='light']) .mg-btn-primary {
    color: #fff;
  }

  .mg-btn-primary:hover {
    opacity: 0.9;
  }

  .mg-install-pill {
    display: inline-flex;
    max-width: 100%;
    align-items: center;
    gap: 0.6rem;
    border-radius: 999px;
    padding: 0.3rem 0.35rem 0.3rem 0.85rem;
    font-family: var(--font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
    box-shadow: inset 0 0 0 1px var(--sl-color-gray-5);
  }

  .mg-install-pill code {
    overflow-wrap: anywhere;
    color: var(--sl-color-white);
    background: none;
    padding: 0;
  }

  .mg-install-pill button {
    border: 0;
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    font: inherit;
    font-family: var(--font-sans);
    font-weight: 600;
    cursor: pointer;
    color: var(--sl-color-gray-2);
    background: var(--sl-color-gray-6);
  }

  .mg-install-pill button:hover {
    color: var(--sl-color-white);
  }

  /* Demo: editor + preview */
  .mg-demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 64rem) {
    .mg-demo {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: stretch;
    }
  }

  .mg-editor {
    border-radius: 1rem;
    overflow: hidden;
    background: var(--mg-editor-bg);
    box-shadow:
      0 0 0 1px var(--mg-editor-line),
      0 24px 48px -16px rgb(0 0 0 / 0.45);
  }

  .mg-editor-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--mg-editor-line);
  }

  .mg-tab-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem;
  }

  .mg-tab-group-label {
    margin-inline-end: 0.35rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6e7681;
  }

  .mg-editor button {
    border: 0;
    border-radius: 0.4rem;
    padding: 0.25rem 0.55rem;
    font-family: var(--font-sans);
    font-size: var(--sl-text-xs);
    cursor: pointer;
    color: #8b949e;
    background: none;
  }

  .mg-editor button:hover,
  .mg-editor [aria-selected='true'] {
    color: #e6edf3;
    background: #21262d;
  }

  .mg-editor [aria-selected='true'] {
    box-shadow: inset 0 -2px 0 var(--color-accent-500);
  }

  .mg-file-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 0.9rem;
    border-bottom: 1px solid var(--mg-editor-line);
  }

  .mg-dots {
    display: flex;
    gap: 0.4rem;
  }

  .mg-dots i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: #30363d;
  }

  .mg-file {
    font-family: var(--font-mono);
    font-size: var(--sl-text-xs);
    color: #8b949e;
  }

  .mg-replay {
    margin-inline-start: auto;
  }

  .mg-code {
    max-width: 100%;
    margin: 0;
    padding: 1rem 1.25rem 1.25rem;
    min-height: 21rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    color: #e6edf3;
    background: none;
  }

  .mg-code code {
    background: none;
    padding: 0;
    white-space: pre;
  }

  .mg-code :global(.mg-line) {
    display: block;
  }

  .mg-code :global(code.is-typing > .mg-line:last-child)::after {
    content: '';
    display: inline-block;
    width: 2px;
    height: 1.1em;
    margin-inline-start: 1px;
    vertical-align: text-bottom;
    background: var(--color-accent-400);
    animation: mg-blink 1s steps(1) infinite;
  }

  @keyframes mg-blink {
    50% {
      opacity: 0;
    }
  }

  .mg-code :global(.tk-keyword) {
    color: #ff7b72;
  }
  .mg-code :global(.tk-string) {
    color: #a5d6ff;
  }
  .mg-code :global(.tk-number) {
    color: #79c0ff;
  }
  .mg-code :global(.tk-fn) {
    color: #d2a8ff;
  }
  .mg-code :global(.tk-type) {
    color: #ffa657;
  }
  .mg-code :global(.tk-var) {
    color: #ffa198;
  }
  .mg-code :global(.tk-punct) {
    color: #8b949e;
  }

  .mg-preview {
    display: flex;
    flex-direction: column;
    border-radius: 1rem;
    padding: 1rem;
    background:
      radial-gradient(circle at 1px 1px, var(--sl-color-gray-5) 1px, transparent 0) 0 0 / 16px 16px,
      var(--sl-color-gray-7, var(--sl-color-gray-6));
    box-shadow: inset 0 0 0 1px var(--sl-color-gray-5);
  }

  .mg-preview-label {
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .mg-receipt {
    margin: auto 0;
    border-radius: 0.9rem;
    padding: 1.5rem;
    background: var(--sl-color-bg);
    box-shadow:
      0 0 0 1px var(--sl-color-gray-5),
      0 12px 32px -12px rgb(0 0 0 / 0.25);
  }

  .mg-receipt-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }

  .mg-check {
    display: inline-grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    font-size: 0.75rem;
    color: #fff;
    background: var(--color-accent-600);
  }

  .mg-amount {
    margin-top: 0.75rem;
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-white);
  }

  .mg-receipt dl {
    margin-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .mg-receipt dl > div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0.75rem;
    padding-block: 0.65rem;
    border-bottom: 1px solid var(--sl-color-gray-6);
    font-size: var(--sl-text-sm);
  }

  .mg-receipt dt {
    color: var(--sl-color-gray-3);
  }

  .mg-receipt dd {
    margin: 0;
    color: var(--sl-color-white);
  }

  .mg-badge {
    margin-inline-start: 0.5rem;
    border-radius: 999px;
    padding: 0.05rem 0.5rem;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    color: var(--sl-color-accent-high);
    background: var(--sl-color-accent-low);
  }

  [data-field] {
    transition:
      opacity 0.3s ease,
      background-color 0.6s ease;
  }

  [data-field].is-empty {
    opacity: 0.12;
  }

  [data-field].is-filled {
    background-color: color-mix(in srgb, var(--color-accent-500) 18%, transparent);
  }

  /* Sections */
  .mg-section {
    margin-top: 3.5rem;
  }

  .mg-section h2 {
    font-size: var(--sl-text-2xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
  }

  .mg-section h3 {
    font-size: var(--sl-text-lg);
    font-weight: 600;
    color: var(--sl-color-white);
  }

  /* Where it runs */
  .mg-platforms {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(26rem, 100%), 1fr));
    gap: 1.25rem;
