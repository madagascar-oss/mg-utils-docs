---
// Footer like tailwindcss.com: link columns + one copyright line. The edit link stays.
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import wordmarkDark from '../assets/brand/wordmark-dark.svg';
import wordmarkLight from '../assets/brand/wordmark-light.svg';
import { links } from '../config/site.ts';
import { localePath, t, toLocale } from '../i18n/ui.ts';

const locale = toLocale(Astro.locals.starlightRoute.locale);
const columns = [
  {
    title: t(locale, 'footer.docs'),
    items: [
      {
        label: t(locale, 'footer.installation'),
        href: localePath(locale, '/docs/installation/using-npm/'),
      },
      { label: t(locale, 'footer.playground'), href: localePath(locale, '/play/') },
    ],
  },
  {
    title: t(locale, 'footer.packages'),
    items: [
      { label: 'npm · @mdgascar/*', href: links.npm },
      { label: 'Packagist · mdgascar/mdg-utils', href: links.packagist },
    ],
  },
  {
    title: t(locale, 'footer.community'),
    items: [
      { label: 'mdg-utils-spec', href: links.spec },
      { label: 'mdg-utils-js', href: links.js },
      { label: 'mdg-utils-php', href: links.php },
      { label: 'mdg-utils-docs', href: links.docs },
    ],
  },
];
---

<footer class="mg-footer">
  <div class="mg-edit">
    <EditLink />
  </div>
  <div class="mg-columns">
    <a class="mg-org" href={links.github} aria-label={t(locale, 'a11y.org')}>
      <img class="light:sl-hidden" src={wordmarkDark.src} alt="Mdgascar" width="151" height="40" />
      <img class="dark:sl-hidden" src={wordmarkLight.src} alt="Mdgascar" width="151" height="40" />
    </a>
    {columns.map((column) => (
      <div>
        <p class="mg-column-title">{column.title}</p>
        <ul>
          {column.items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <p class="mg-copyright">
    © {new Date().getFullYear()} Mdgascar contributors. {t(locale, 'footer.license')}
  </p>
</footer>

<style>
  .mg-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--mg-grid-line);
    font-size: var(--sl-text-sm);
  }

  .mg-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .mg-org img {
    width: 11.5rem;
    height: auto;
  }

  .mg-column-title {
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .mg-columns ul {
    margin-top: 0.75rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  .mg-columns a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }

  .mg-columns a:hover {
    color: var(--sl-color-white);
  }

  .mg-copyright {
    margin-top: 2rem;
    color: var(--sl-color-gray-3);
  }
</style>
