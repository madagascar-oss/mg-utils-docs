---
// Embeds the Try it widget in a docs page, with labels and the playground link for the page's locale.
import TryIt from './try-it/TryIt.tsx';
import { localePath, toLocale } from '../i18n/ui.ts';
import type { ModuleId } from '../playground/types.ts';

interface Props {
  module: ModuleId;
}

const locale = toLocale(Astro.locals.starlightRoute.locale);
const labels = {
  en: { input: 'Input', option: 'Option', result: 'Result', open: 'Open in the playground' },
  mg: {
    input: 'Fampidirana',
    option: 'Safidy',
    result: 'Valiny',
    open: 'Sokafy ao amin’ny toerana fanandramana',
  },
  fr: { input: 'Entrée', option: 'Option', result: 'Résultat', open: 'Ouvrir dans le bac à sable' },
}[locale];
---

<TryIt
  client:visible
  module={Astro.props.module}
  playHref={localePath(locale, '/play/')}
  labels={labels}
/>
