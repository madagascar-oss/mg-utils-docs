---
// Header laid out like tailwindcss.com/docs: logo + version, search, Docs · Play · Spec, then
// GitHub, theme and language. Starlight's own pieces are reused so search and menus keep working.
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import { versionLabel } from '../config/site.ts';
import { localePath, t, toLocale } from '../i18n/ui.ts';

const locale = toLocale(Astro.locals.starlightRoute.locale);
const current = Astro.url.pathname;
const nav = [
  {
    label: t(locale, 'nav.docs'),
    href: localePath(locale, '/docs/installation/using-npm/'),
    match: '/docs/',
  },
  { label: t(locale, 'nav.play'), href: localePath(locale, '/play/'), match: '/play/' },
  { label: t(locale, 'nav.spec'), href: localePath(locale, '/docs/spec/'), match: '/docs/spec/' },
];
const isActive = (match: string) =>
  match === '/docs/'
    ? current.includes('/docs/') && !current.includes('/docs/spec/')
    : current.includes(match);
---

<div class="mg-header">
  <div class="mg-brand">
    <SiteTitle />
    <span class="mg-version" title="Package version">
      {versionLabel}
    </span>
  </div>
  <div class="mg-search print:hidden">
    <Search />
  </div>
  <nav class="mg-nav sl-hidden md:sl-flex print:hidden" aria-label="Site">
    {nav.map((item) => (
      <a href={item.href} aria-current={isActive(item.match) ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
  <div class="mg-actions sl-hidden md:sl-flex print:hidden">
    <span class="mg-divider" aria-hidden="true"></span>
    <SocialIcons />
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<style>
  .mg-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
  }

  .mg-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    overflow: clip;
  }

  .mg-version {
    border-radius: 999px;
    padding: 0.125rem 0.5rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .mg-search {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .mg-nav {
    gap: 1.25rem;
    font-size: var(--sl-text-sm);
    font-weight: 500;
  }

  .mg-nav a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }

  .mg-nav a:hover,
  .mg-nav a[aria-current='page'] {
    color: var(--sl-color-white);
  }

  .mg-nav a[aria-current='page'] {
    color: var(--sl-color-accent-high);
  }

  .mg-actions {
    align-items: center;
    gap: 1rem;
  }

  .mg-divider {
    width: 1px;
    height: 1.5rem;
    background: var(--sl-color-gray-5);
  }
</style>
