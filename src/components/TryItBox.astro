---
// Embeds the Try it widget in a docs page, with labels and the playground link for the page's locale.
import TryIt from './try-it/TryIt.tsx';
import { localePath, toLocale } from '../i18n/ui.ts';
import type { ModuleId } from '../playground/types.ts';

interface Props {
  module: ModuleId;
  /** Starting input; the module's default when omitted. */
  input?: string;
  /** Starting option (e.g. a words system); the module's first option when omitted. */
  option?: string;
  /** Inputs offered as one-click chips under the field. */
  examples?: readonly string[];
}

const locale = toLocale(Astro.locals.starlightRoute.locale);
const labels = {
  en: {
    input: 'Input',
    option: 'Option',
    result: 'Result',
    examples: 'Examples',
    open: 'Open in the playground',
  },
  fr: {
    input: 'Entrée',
    option: 'Option',
    result: 'Résultat',
    examples: 'Exemples',
    open: 'Ouvrir dans le bac à sable',
  },
}[locale];
---

<TryIt
  client:visible
  module={Astro.props.module}
  initialInput={Astro.props.input}
  initialOption={Astro.props.option}
  examples={Astro.props.examples ?? []}
  playHref={localePath(locale, '/play/')}
  labels={labels}
/>
